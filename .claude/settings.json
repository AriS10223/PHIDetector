{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "P=python; python3 -c '' 2>/dev/null && P=python3; \"$P\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/pii_check.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "P=python; python3 -c '' 2>/dev/null && P=python3; \"$P\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/pii_check.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "P=python; python3 -c '' 2>/dev/null && P=python3; \"$P\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/pii_check.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "MessageDisplay": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "P=python; python3 -c '' 2>/dev/null && P=python3; \"$P\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/pii_check.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "P=python; python3 -c '' 2>/dev/null && P=python3; \"$P\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/pii_check.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
